# Kopie als .env anlegen und Passwörter ändern (setup-fedora.sh erzeugt sie zufällig)
PBX_ADMIN_PASSWORD=bitte-aendern-12345
CARRIER_PASSWORD=bitte-aendern-carrier
# Fertiges Abbild (Standard) oder eigenes, z. B. localhost/phone4all-pbx:test
# PBX_IMAGE=ghcr.io/henne-407/phone4all-pbx:latest
# LAN-Adresse dieses Rechners: echte Telefone im LAN können die Test-Anlage dann nutzen
# PBX_EXTERNAL_ADDRESS=192.168.2.50
# Nur lokal erreichbar statt im ganzen LAN
# P4A_BIND=127.0.0.1
